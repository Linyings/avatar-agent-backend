narratoai.cn {
    encode zstd gzip

    request_body {
        max_size 500MB
    }

    handle /api/health {
        rewrite * /health
        reverse_proxy api:8000
    }

    # Fish.audio is intentionally owned by the frontend Nginx image.
    handle /api/fish-audio-proxy/* {
        reverse_proxy frontend:80
    }

    handle /api/* {
        reverse_proxy api:8000 {
            transport http {
                dial_timeout 15s
                response_header_timeout 10m
            }
        }
    }

    handle {
        reverse_proxy frontend:80
    }

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
}
