FRONTEND_IMAGE=registry.cn-hangzhou.aliyuncs.com/narratoai/narratoai-frontend:sha-example
BACKEND_IMAGE=registry.cn-hangzhou.aliyuncs.com/narratoai/narratoai-backend-go:sha-example
POSTGRES_PASSWORD=replace-with-production-password
POSTGRES_VOLUME_NAME=narratoai_postgres_data
WECHAT_CERT_HOST_DIR=/root/narratoai-backend-go/wechat_certs
ALIPAY_CERT_HOST_DIR=/root/narratoai/alipay_certs
DESKTOP_UPDATE_HOST_DIR=/srv/narratoai-updates

# PC 剧集模式剧情检索；部署前填写真实密钥。
TAVILY_API_KEY=
TAVILY_API_BASE_URL=https://api.tavily.com
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=5
TAVILY_REQUEST_TIMEOUT_SECONDS=20

# DashScope / Qwen / FunASR
# 千问语音合成模型；与 ASR、视觉模型集中管理。flash 不支持自然语言情绪/语速指令。
QWEN_TTS_MODEL=qwen3-tts-flash

# 电影模式：解说稿专用模型（独立于 PRO / Flash；仅写作及文案重写使用）
# 必填 KEY / BASE_URL / MODEL；不自动回退到 PRO / Flash。修改后重启后端生效。
MOVIE_NARRATION_API_KEY=
MOVIE_NARRATION_API_BASE_URL=
MOVIE_NARRATION_MODEL=
# 留空沿用电影任务的思考策略；可按供应商设置 enabled / disabled 和推理强度。
MOVIE_NARRATION_THINKING_TYPE=
MOVIE_NARRATION_REASONING_EFFORT=
