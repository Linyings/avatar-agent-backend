# NarratoAI SaaS Go 后端环境变量示例。
# 使用方式：复制为 .env 后按本地或部署环境填写真实值。

# 数字人口播 MVP（详见 docs/avatar-mvp.md；默认关闭，不自动调用付费生成）
AVATAR_MVP_ENABLED=false
# 首条三镜基准片人工验收通过后才改为 true；首条使用固定分镜。
AVATAR_MVP_BASELINE_APPROVED=false
# Optional: one explicitly authorized client_request_id, consumed once globally.
# This does not disable per-shot quality checks or approve the baseline.
AVATAR_MVP_BASELINE_REQUEST_ID=
# 视频模型独立配置；原生协议 runninghub / minimax，其他厂商可接 http 网关协议。
VIDEO_PROVIDER=runninghub
VIDEO_API_PROTOCOL=
VIDEO_API_BASE_URL=
VIDEO_API_KEY=
VIDEO_MODEL=
VIDEO_RESOLUTION=
# 仅 http 网关使用；须确实支持人物图片和指定配音参考。
VIDEO_REFERENCE_AUDIO_SUPPORTED=false
VIDEO_UPLOAD_PATH=
VIDEO_GENERATION_PATH=
VIDEO_QUERY_PATH=
# 厂商专用 Key 为兼容配置；优先使用 VIDEO_API_KEY，不跨厂商复用。
RUNNINGHUB_BASE_URL=https://www.runninghub.cn
RUNNINGHUB_API_KEY=
MINIMAX_API_KEY=
AVATAR_MVP_DATA_ROOT=data/avatar-mvp
AVATAR_MVP_RUNTIME_ROOT=avatar-runtime
# Windows 示例：.venv-avatar/Scripts/python.exe；Linux 示例：.venv-avatar/bin/python
AVATAR_MVP_PYTHON=python
AVATAR_MVP_NODE=node
# 必须为完整 FFmpeg/FFprobe，不能使用 Remotion 内置的精简版 ffmpeg。
AVATAR_MVP_FFMPEG=ffmpeg
AVATAR_MVP_FFPROBE=ffprobe
AVATAR_MVP_ASR_BACKEND=whisper
# 可指定本地 faster-whisper small 模型目录；空值首次使用时下载 small 权重。
AVATAR_MVP_ASR_MODEL_DIR=
AVATAR_MVP_TIMEOUT_MINUTES=60

# 应用基础配置
DEBUG=true
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# API 路径配置
API_V1_PREFIX=/api/v1
OPENAPI_URL=/api/v1/openapi.json
DOCS_URL=/docs
REDOC_URL=/redoc

# 数据库配置
# docker-compose.yml 默认将 PostgreSQL 容器的 5432 端口映射到宿主机 15432，便于迁移期临时导入数据。
# 迁移完成后建议将 POSTGRES_BIND_ADDRESS 改为 127.0.0.1，或删除 docker-compose.yml 中的 postgres ports 映射。
POSTGRES_DB=narratoai
POSTGRES_USER=narratoai
POSTGRES_PASSWORD=narratoai
POSTGRES_BIND_ADDRESS=0.0.0.0
POSTGRES_PORT=15432
DOCKER_DATABASE_URL=postgres://narratoai:narratoai@postgres:5432/narratoai?sslmode=disable
DATABASE_URL=postgres://narratoai:narratoai@localhost:15432/narratoai?sslmode=disable
AUTO_MIGRATE=true

# 4C4G 单机部署下的 PostgreSQL 保守参数，可按监控结果调整。
POSTGRES_MAX_CONNECTIONS=50
POSTGRES_SHARED_BUFFERS=768MB
POSTGRES_EFFECTIVE_CACHE_SIZE=2GB
POSTGRES_MAINTENANCE_WORK_MEM=128MB
POSTGRES_WORK_MEM=8MB
POSTGRES_WAL_BUFFERS=16MB
POSTGRES_CHECKPOINT_COMPLETION_TARGET=0.9
POSTGRES_CHECKPOINT_TIMEOUT=10min
POSTGRES_MAX_WAL_SIZE=1GB
POSTGRES_MIN_WAL_SIZE=256MB
POSTGRES_RANDOM_PAGE_COST=1.1
POSTGRES_LOG_MIN_DURATION_STATEMENT=500
POSTGRES_SHM_SIZE=512mb

# 认证与跨域配置
# 生产环境必须替换为足够长、随机且不可泄露的密钥。
SECRET_KEY=change-me-change-me-change-me-change-me
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
FRONTEND_BASE_URL=http://localhost:5173
# Optional: comma-separated frontend origins allowed for OAuth callbacks.
# The first value is used as the default callback origin.
FRONTEND_BASE_URLS=http://localhost:5173
PUBLIC_API_BASE_URL=http://localhost:8000

# 邮箱验证码 SMTP 配置
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=NarratoAI
SMTP_USE_TLS=true
# 产品更新批量邮件配置：必须与验证码 SMTP 使用不同的发件地址。
# 未完整配置时，批量发送器保持禁用状态。
CAMPAIGN_SMTP_HOST=
CAMPAIGN_SMTP_PORT=465
CAMPAIGN_SMTP_USERNAME=
CAMPAIGN_SMTP_PASSWORD=
CAMPAIGN_SMTP_FROM_EMAIL=
CAMPAIGN_SMTP_FROM_NAME=NarratoAI
CAMPAIGN_SMTP_REPLY_TO=
CAMPAIGN_SMTP_USE_TLS=true
CAMPAIGN_UNSUBSCRIBE_BASE_URL=https://api.narratoai.cn

# 第三方登录 OAuth 配置
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: route server-side Google OAuth calls through an overseas reverse proxy.
# Keep the browser auth URL on Google; only token/userinfo need proxying from domestic servers.
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 微信支付配置
# 只有测试真实支付链路时才需要填写。
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_V3_KEY=
WECHAT_PRIVATE_KEY=
WECHAT_PRIVATE_KEY_FILE=
WECHAT_CERT_SERIAL_NO=
WECHAT_NOTIFY_URL=
WECHAT_CERT_DIR=./data/wechat_certs
WECHAT_VERIFY_SIGNATURE=true

# Creem 支付配置
# Creem 用于订阅和非微信的一次性 Credits 购买；微信支付继续使用上方微信商户配置。
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_TEST_MODE=true
CREEM_SUCCESS_URL=
CREEM_PORTAL_RETURN_URL=

# DashScope / Qwen3 / FunASR 配置
DASHSCOPE_API_KEY=
# DashScope 原生 API 固定使用 https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_USE_INTL=false
DASHSCOPE_REQUEST_TIMEOUT_SECONDS=60
# 千问语音合成模型；与 ASR、视觉模型集中管理。flash 不支持自然语言情绪/语速指令。
QWEN_TTS_MODEL=qwen3-tts-flash
QWEN3_ASR_MODEL=qwen3-asr-flash-filetrans
FUNASR_MODEL=fun-asr
# 视觉模型：画面分析统一使用此模型；omni 模型（如 qwen3.8-omni-flash）按视频片段输入，其他模型按拼图输入。复用 DASHSCOPE_API_KEY
QWEN_VISION_MODEL=qwen3.8-omni-flash
QWEN_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Tavily 剧集剧情检索配置（仅 PC 剧集模式使用）
TAVILY_API_KEY=
TAVILY_API_BASE_URL=https://api.tavily.com
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=5
TAVILY_REQUEST_TIMEOUT_SECONDS=20

# SiliconFlow 配置
SILICONFLOW_API_KEY=
SILICONFLOW_API_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
# 留空时使用 ${SILICONFLOW_TTS_MODEL}:alex；也可填 fishaudio/fish-speech-1.5:alex 等完整音色 URI
SILICONFLOW_TTS_VOICE=

# OpenAI 兼容大模型配置
# 新部署优先配置 pro / flash 两套独立 profile；pro 用于剧情理解等任务，flash 用于其它轻量步骤；电影解说写作使用独立 MOVIE_NARRATION 配置。
# 电影模式：解说稿专用模型（独立于 PRO / Flash；仅写作及文案重写使用）
# 必填 KEY / BASE_URL / MODEL；不自动回退到 PRO / Flash。修改后重启后端生效。
MOVIE_NARRATION_API_KEY=
MOVIE_NARRATION_API_BASE_URL=
MOVIE_NARRATION_MODEL=
# 留空沿用电影任务的思考策略；可按供应商设置 enabled / disabled 和推理强度。
MOVIE_NARRATION_THINKING_TYPE=
MOVIE_NARRATION_REASONING_EFFORT=

OPENAI_PRO_API_KEY=
OPENAI_PRO_API_BASE_URL=https://api.deepseek.com
OPENAI_PRO_MODEL=deepseek-v4-pro
OPENAI_PRO_THINKING_TYPE=enabled
OPENAI_PRO_REASONING_EFFORT=max
OPENAI_FLASH_API_KEY=
OPENAI_FLASH_API_BASE_URL=https://api.deepseek.com
OPENAI_FLASH_MODEL=deepseek-v4-flash
OPENAI_FLASH_THINKING_TYPE=disabled
# DeepSeek 支持 none 关闭思考；旧中转网关可能丢弃 thinking 字段，需同时传递此值。
# 若更换为不支持 none 的供应商，请按其参数协议调整。
OPENAI_FLASH_REASONING_EFFORT=none
OPENAI_TEMPERATURE=0.7
# 大模型 Prompt 缓存策略：auto/off/openai/dashscope_explicit
# auto 默认针对 DashScope/百炼开启显式缓存；OpenAI 官方接口可附加 prompt_cache_key。
LLM_PROMPT_CACHE_MODE=auto
OPENAI_PROMPT_CACHE_KEY_ENABLED=true
OPENAI_PROMPT_CACHE_RETENTION=
DASHSCOPE_EXPLICIT_CACHE_ENABLED=true

# FishAudio 配置
FISH_AUDIO_API_KEY=
FISH_AUDIO_BASE_URL=https://api.fish.audio
FISH_AUDIO_MODEL=s1

# ElevenLabs Scribe ASR 配置
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_SCRIBE_MODEL=scribe_v2
# Payment channels: subscriptions use Alipay automatic renewal; one-time Credits
# accept WeChat Pay and Alipay QR payments. Credential material stays in ignored
# files under data/, never in this example file.
SUBSCRIPTION_PAYMENT_PROVIDER=alipay
CREDIT_PAYMENT_PROVIDER=one_time
CREEM_CHECKOUT_ENABLED=false

# 支付宝 AI 订阅配置（审核和沙箱联调后手动填写，禁止提交真实密钥）
ALIPAY_APP_ID=
ALIPAY_MERCHANT_ID=
ALIPAY_PRIVATE_KEY_FILE=data/alipay_certs/app_private_key.pem
ALIPAY_PUBLIC_KEY_FILE=data/alipay_certs/alipay_public_key.pem
ALIPAY_CERT_HOST_DIR=./data/alipay_certs
ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do
ALIPAY_NOTIFY_URL=https://api.example.com/api/v1/credit-payments/alipay/webhook
ALIPAY_RETURN_URL=
ALIPAY_PORTAL_URL=

# One-time credit payment callback. This is the shared WeChat callback setting
# consumed by the backend for credit-payment notifications.
WECHAT_NOTIFY_URL=https://api.example.com/api/v1/credit-payments/wechat/webhook
