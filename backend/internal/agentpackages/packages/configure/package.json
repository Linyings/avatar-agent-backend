{
  "id": "avatar.configure",
  "version": "1.0.0",
  "tool": "avatar_configure",
  "title": "制作需求",
  "node": "F01",
  "entrypoint": "configure",
  "dependencies": [],
  "outputs": [
    "制作参数"
  ],
  "description": "保存主题、稿件、风格、音色和画幅。不会启动生成。先读取项目状态，保留用户已确定的参数。",
  "input_schema": {
    "type": "object",
    "properties": {
      "revision": {
        "type": "integer",
        "minimum": 0
      },
      "title": {
        "type": "string",
        "description": "标题",
        "maxLength": 10000
      },
      "topic": {
        "type": "string",
        "description": "需求或主题",
        "maxLength": 10000
      },
      "script": {
        "type": "string",
        "description": "完整口播稿",
        "maxLength": 10000
      },
      "direction": {
        "type": "string",
        "description": "制作要求",
        "maxLength": 10000
      },
      "style": {
        "type": "string",
        "description": "风格 ID，先查 avatar_inspect",
        "maxLength": 10000
      },
      "voice": {
        "type": "string",
        "description": "服务端音色 ID",
        "maxLength": 10000
      },
      "voice_model": {
        "type": "string",
        "description": "配音模型 ID（RunningHub 标准语音合成模型，如 minimax/speech-2.8-hd、doubao-seed-tts-2.0、alibaba/qwen3-tts-flash、kling-lip-sync/tts）；先用 avatar_inspect 读取 voice_models，音色必须属于该模型",
        "maxLength": 200
      },
      "ratio": {
        "type": "string",
        "enum": [
          "9:16",
          "16:9",
          "1:1"
        ]
      },
      "use_avatar": {
        "type": "boolean",
        "description": "是否由人物参考图生成口播视频。保留项目已有选择；首页新项目默认与动效同时启用，不能因选择动效风格而关闭人物。"
      },
      "use_animation": {
        "type": "boolean",
        "description": "是否制作动效画面。先读取并保留项目已有选择；首页新项目默认与人物口播同时启用。已选动效风格或已有融合要求时保持 true，不能因本轮只提口播而关闭。只有用户明确要求不要动效、纯人物时才改为 false。"
      },
      "reference_links": {
        "type": "array",
        "description": "用户提供的参考网页网址；只保存地址，不表示已读取页面正文",
        "maxItems": 20,
        "items": {
          "type": "string",
          "maxLength": 2048
        }
      },
      "angles": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "正面",
            "左前方20度",
            "右前方20度"
          ]
        },
        "maxItems": 100
      },
      "voice_speed": {
        "type": "number",
        "minimum": 0.8,
        "maximum": 1.3,
        "description": "全片配音速度倍率，默认保留原速；可先试 1.1"
      },
      "segment_voice_speeds": {
        "type": "object",
        "description": "按段落 ID 覆盖全片语速，空对象清除所有单段覆盖",
        "additionalProperties": {
          "type": "number",
          "minimum": 0.8,
          "maximum": 1.3
        }
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "tools": [
    "project.configure"
  ]
}
